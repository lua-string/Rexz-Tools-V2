local rainbowColors = {
    Color3.fromRGB(235,70,70),
    Color3.fromRGB(255,145,55),
    Color3.fromRGB(250,220,85),
    Color3.fromRGB(100,195,110),
    Color3.fromRGB(75,155,235),
    Color3.fromRGB(125,95,210),
    Color3.fromRGB(205,115,205)
}

local function stopFlight()
    flightActive = false
    flightGeneration += 1
    verticalInput = 0

    for _,object in ipairs(flightObjects) do
        if object and object.Parent then
            object:Destroy()
        end
    end
    table.clear(flightObjects)

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if root then root.AssemblyLinearVelocity = Vector3.zero end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    if flightGui then flightGui.Enabled = false end
end

local function startFlight()
    if flightActive then
        stopFlight()
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end

    flightActive = true
    flightGeneration += 1
    local myGeneration = flightGeneration

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    local carpet = Instance.new("Part")
    carpet.Name = "LocalRainbowFlyingCarpet"
    carpet.Size = Vector3.new(5,0.22,3)
    carpet.Material = Enum.Material.SmoothPlastic
    carpet.Color = rainbowColors[1]
    carpet.CanCollide = false
    carpet.Massless = true
    carpet.Anchored = false
    carpet.CFrame = root.CFrame*CFrame.new(0,-3.1,0)
    carpet.Parent = workspace
    table.insert(flightObjects,carpet)

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = carpet
    weld.Parent = carpet

    for i,color in ipairs(rainbowColors) do
        local stripe = Instance.new("Part")
        stripe.Name = "RainbowStripe"
        stripe.Size = Vector3.new(5/7,0.07,3)
        stripe.Color = color
        stripe.Material = Enum.Material.SmoothPlastic
        stripe.CanCollide = false
        stripe.Massless = true
        stripe.Anchored = false
        stripe.CFrame = carpet.CFrame*CFrame.new((i-4)*5/7,0.14,0)
        stripe.Parent = workspace
        table.insert(flightObjects,stripe)

        local stripeWeld = Instance.new("WeldConstraint")
        stripeWeld.Part0 = carpet
        stripeWeld.Part1 = stripe
        stripeWeld.Parent = stripe
    end

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "CarpetFlightVelocity"
    velocity.MaxForce = Vector3.new(1e7,1e7,1e7)
    velocity.P = 15000
    velocity.Velocity = Vector3.zero
    velocity.Parent = root
    table.insert(flightObjects,velocity)

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "CarpetFlightGyro"
    gyro.MaxTorque = Vector3.new(1e7,1e7,1e7)
    gyro.P = 18000
    gyro.D = 800
    gyro.CFrame = root.CFrame
    gyro.Parent = root
    table.insert(flightObjects,gyro)

    if flightGui then flightGui.Enabled = true end

    task.spawn(function()
        while flightActive
            and flightGeneration == myGeneration
            and root.Parent
            and humanoid.Health > 0 do

            local camera = workspace.CurrentCamera
            local move = humanoid.MoveDirection
            local horizontal = Vector3.zero

            if camera then
                local look = camera.CFrame.LookVector
                local right = camera.CFrame.RightVector
                local forward = Vector3.new(look.X,0,look.Z)
                local side = Vector3.new(right.X,0,right.Z)

                if forward.Magnitude > 0 then forward = forward.Unit end
                if side.Magnitude > 0 then side = side.Unit end

                horizontal = forward*move:Dot(forward)
                    + side*move:Dot(side)

                if horizontal.Magnitude > 1 then
                    horizontal = horizontal.Unit
                end

                velocity.Velocity =
                    horizontal*55+Vector3.new(0,verticalInput*35,0)

                if horizontal.Magnitude > 0.1 then
                    gyro.CFrame = CFrame.lookAt(
                        root.Position,root.Position+horizontal
                    )
                end
            end

            RunService.Heartbeat:Wait()
        end

        if flightActive and flightGeneration == myGeneration then
            stopFlight()
        end
    end)
end

