--========================================================
-- 🧰 UTILITIES
--========================================================

local function findTool(name)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local character = player.Character

    return (backpack and backpack:FindFirstChild(name))
        or (character and character:FindFirstChild(name))
end

local function rounded(object,radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,radius or 10)
    corner.Parent = object
    return corner
end

local function outline(object,color,thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or WHITE
    stroke.Thickness = thickness or 1.5
    stroke.Parent = object
    return stroke
end

--========================================================
-- 💣 GOLD FAKE BOMB
--========================================================

local function makeBomb(parent,name)
    local bomb = Instance.new("Part")
    bomb.Name = name or "Handle"
    bomb.Size = Vector3.new(1.45,0.85,1.8)
    bomb.Color = bombColor
    bomb.Material = Enum.Material.Metal
    bomb.Anchored = false
    bomb.CanCollide = true
    bomb.Parent = parent

    local cap = Instance.new("Part")
    cap.Name = "BombCap"
    cap.Size = Vector3.new(0.42,0.18,0.42)
    cap.Color = bombColor:Lerp(DARK_GOLD,0.45)
    cap.Material = Enum.Material.Metal
    cap.CanCollide = false
    cap.Massless = true
    cap.CFrame = bomb.CFrame*CFrame.new(0,0.49,0)
    cap.Parent = parent

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = bomb
    weld.Part1 = cap
    weld.Parent = cap

    return bomb
end

local function recolorBombs()
    for bomb in pairs(activeBombs) do
        if bomb and bomb.Parent then
            bomb.Color = bombColor
            local cap = bomb:FindFirstChild("BombCap")
            if cap then
                cap.Color = bombColor:Lerp(DARK_GOLD,0.45)
            end
        else
            activeBombs[bomb] = nil
        end
    end

    local tool = findTool("Gold Fake Bomb")
    local handle = tool and tool:FindFirstChild("Handle")
    if handle then
        handle.Color = bombColor
        local cap = handle:FindFirstChild("BombCap")
        if cap then cap.Color = bombColor:Lerp(DARK_GOLD,0.45) end
    end
end

local function createExplosion(position)
    local effect = Instance.new("Part")
    effect.Name = "GoldBombExplosionEffect"
    effect.Shape = Enum.PartType.Ball
    effect.Size = Vector3.new(1,1,1)
    effect.Position = position
    effect.Anchored = true
    effect.CanCollide = false
    effect.CanTouch = false
    effect.CanQuery = false
    effect.Material = Enum.Material.Neon
    effect.Color = effectColor
    effect.Transparency = 0.15
    effect.Parent = workspace

    local attachment = Instance.new("Attachment")
    attachment.Parent = effect

    local particles = Instance.new("ParticleEmitter")
    particles.Color = ColorSequence.new(effectColor)
    particles.Lifetime = NumberRange.new(0.3,0.7)
    particles.Speed = NumberRange.new(5,11)
    particles.SpreadAngle = Vector2.new(180,180)
    particles.Rate = 0
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0,0.3),
        NumberSequenceKeypoint.new(1,0)
    })
    particles.Parent = attachment
    particles:Emit(28)

    TweenService:Create(effect,TweenInfo.new(0.45),{
        Size = Vector3.new(8,8,8),
        Transparency = 1
    }):Play()

    Debris:AddItem(effect,1)
end

local function createBombTool()
    local backpack = player:WaitForChild("Backpack")
    if findTool("Gold Fake Bomb") then return end

    local tool = Instance.new("Tool")
    tool.Name = "Gold Fake Bomb"
    tool.ToolTip = "Tap to drop a fake bomb"
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = makeBomb(tool,"Handle")
    handle.Massless = true
    handle.CanCollide = false

    tool.Activated:Connect(function()
        if busy or os.clock()-lastUse < cooldown then return end

        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root then return end

        busy = true
        lastUse = os.clock()

        local dropped = makeBomb(workspace,"DroppedGoldFakeBomb")
        dropped.CFrame = root.CFrame*CFrame.new(0,-2.7,-0.7)
        activeBombs[dropped] = true
        dropped.AssemblyLinearVelocity =
            root.AssemblyLinearVelocity+root.CFrame.LookVector*1.5

        task.delay(0.8,function()
            if dropped and dropped.Parent then
                createExplosion(dropped.Position)
                activeBombs[dropped] = nil
                dropped:Destroy()
            end
        end)

        task.delay(math.max(cooldown,0.1),function()
            busy = false
        end)
    end)

    tool.Parent = backpack
end

