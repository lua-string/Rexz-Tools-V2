bindHold(downButton,-1)

stopButton.Activated:Connect(function()
    verticalInput = 0
end)

landButton.Activated:Connect(stopFlight)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        verticalInput = 0
    end
end)

local function createFlyingCarpetTool()
    local name = "Rainbow Flying Carpet"
    if findTool(name) then return false end

    local tool = Instance.new("Tool")
    tool.Name = name
    tool.ToolTip = "Tap to fly or stop flying"
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1,0.25,1)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    tool.Activated:Connect(startFlight)
    tool.Unequipped:Connect(function()
        if flightActive then stopFlight() end
    end)
    tool.Destroying:Connect(function()
        if flightActive then stopFlight() end
    end)

    tool.Parent = player:WaitForChild("Backpack")
    return true
end

--========================================================
-- ➕ ADD / REMOVE TOOLS
--========================================================

local function addTool(name)
    if findTool(name) then return false end

    local success = false

    if name == "Speed Coil" then
        success = createCoil("Speed")
    elseif name == "Gravity Coil" then
        success = createCoil("Gravity")
    elseif name == "Rainbow Flying Carpet" then
        success = createFlyingCarpetTool()
    end

    if success then coilTools[name] = true end
    return success
end

local function removeTool(name)
    local tool = findTool(name)
    if tool then tool:Destroy() end
    coilTools[name] = false
end

--========================================================
-- 🔄 RESPAWN SUPPORT
--========================================================

local function restoreTools()
    if restoring then return end
    restoring = true

    task.spawn(function()
        local character = player.Character or player.CharacterAdded:Wait()
        player:WaitForChild("Backpack")
        task.wait(1)

        if player.Character == character then
            createBombTool()

            for name,enabled in pairs(coilTools) do
                if enabled and not findTool(name) then
                    addTool(name)
                end
            end
        end

        restoring = false
    end)
end

player.CharacterAdded:Connect(function()
    if flightActive then stopFlight() end
    restoreTools()
end)

restoreTools()

