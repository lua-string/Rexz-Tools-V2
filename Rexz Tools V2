local function createCoil(kind)
    local name = kind.." Coil"
    if findTool(name) then return false end

    local isSpeed = kind == "Speed"
    local color = isSpeed
        and Color3.fromRGB(235,65,65)
        or Color3.fromRGB(65,145,255)

    local tool = Instance.new("Tool")
    tool.Name = name
    tool.ToolTip = "Equip to activate "..name
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.4,1.2,0.4)
    handle.Shape = Enum.PartType.Cylinder
    handle.Color = color
    handle.Material = Enum.Material.SmoothPlastic
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    for i=1,12 do
        local angle = i*math.pi*0.8

        local segment = Instance.new("Part")
        segment.Name = "SpringSegment"
        segment.Shape = Enum.PartType.Ball
        segment.Size = Vector3.new(0.22,0.22,0.22)
        segment.Color = color
        segment.Material = Enum.Material.SmoothPlastic
        segment.CanCollide = false
        segment.Massless = true
        segment.CFrame = handle.CFrame*CFrame.new(
            math.cos(angle)*0.25,
            -0.5+(i-1)*0.09,
            math.sin(angle)*0.25
        )
        segment.Parent = tool

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = segment
        weld.Parent = segment
    end

    local equipped = false
    local humanoid
    local oldSpeed
    local oldGravity

    local function deactivate()
        if not equipped then return end
        equipped = false

        if isSpeed then
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed = oldSpeed or 16
            end
        else
            workspace.Gravity = oldGravity or 196.2
        end

        humanoid = nil
    end

    tool.Equipped:Connect(function()
        local char = player.Character
        local h = char and char:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return end

        humanoid = h
        equipped = true

        if isSpeed then
            oldSpeed = h.WalkSpeed
            h.WalkSpeed = 32
        else
            oldGravity = workspace.Gravity
            workspace.Gravity = 100
        end
    end)

    tool.Unequipped:Connect(deactivate)
    tool.Destroying:Connect(deactivate)
    tool.Parent = player:WaitForChild("Backpack")

    return true
end

